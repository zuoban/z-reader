{
  "name": "frontend",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/build-foliate.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/build-foliate.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "lint:strict": "eslint --max-warnings=0",
    "pretest:unit": "node scripts/build-foliate.mjs",
    "test:unit": "vitest run",
    "pretest:coverage": "node scripts/build-foliate.mjs",
    "test:coverage": "vitest run --coverage",
    "test:coverage:check": "npm run test:coverage && node scripts/check-coverage-baseline.mjs coverage/coverage-summary.json coverage-baseline.json",
    "test:coverage:baseline": "npm run test:coverage && node scripts/check-coverage-baseline.mjs coverage/coverage-summary.json coverage-baseline.json --write",
    "pretest:unit:watch": "node scripts/build-foliate.mjs",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test tests/e2e/auth-shelf.spec.ts tests/e2e/shelf-virtual-grid.spec.ts tests/e2e/reader-happy-path.spec.ts tests/e2e/multi-format.spec.ts tests/e2e/tts-background.spec.ts tests/e2e/shelf-to-reader.spec.ts tests/e2e/shelf-search.spec.ts tests/e2e/shelf-batch.spec.ts tests/e2e/a11y.spec.ts tests/e2e/responsive-layout.spec.ts tests/e2e/performance-budget.spec.ts",
    "test:e2e:search": "playwright test tests/e2e/shelf-search.spec.ts",
    "test:e2e:batch": "playwright test tests/e2e/shelf-batch.spec.ts",
    "test:e2e:virtual": "playwright test tests/e2e/shelf-virtual-grid.spec.ts",
    "test:e2e:reader": "playwright test tests/e2e/reader-happy-path.spec.ts tests/e2e/multi-format.spec.ts tests/e2e/tts-background.spec.ts tests/e2e/shelf-to-reader.spec.ts",
    "test:e2e:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "test:e2e:perf": "playwright test tests/e2e/performance-budget.spec.ts",
    "test:js-budget": "node scripts/check-js-budget.mjs",
    "test:js-budget:baseline": "node scripts/check-js-budget.mjs --write",
    "test:visual": "playwright test tests/e2e/visual-regression.spec.ts",
    "test:visual:update": "playwright test tests/e2e/visual-regression.spec.ts --update-snapshots",
    "test:visual:update:linux": "bash scripts/update-visual-linux.sh",
    "test:visual:ui": "playwright test tests/e2e/visual-regression.spec.ts --ui",
    "test:perf:production": "node scripts/run-production-performance.mjs",
    "test:tts:provider": "node scripts/measure-tts-provider.mjs",
    "test:tts:provider:cli": "node --test scripts/measure-tts-provider.test.mjs"
  },
  "dependencies": {
    "@fontsource/crimson-text": "^5.3.0",
    "@fontsource/lxgw-wenkai-tc": "^5.3.1",
    "@fontsource/noto-serif-sc": "^5.3.1",
    "@fontsource/playfair-display": "^5.3.0",
    "@mantine/core": "^9.8.2",
    "@mantine/hooks": "^9.8.2",
    "@tanstack/react-virtual": "^3.14.27",
    "clsx": "^2.1.1",
    "lucide-react": "^1.77.0",
    "next": "^16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^31.0.1",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23"
    },
    "sharp": "0.35.5"
  }
}
