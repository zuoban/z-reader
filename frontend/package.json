{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "lint:strict": "eslint --max-warnings=0",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:check": "npm run test:coverage && node scripts/check-coverage-baseline.mjs coverage/coverage-summary.json coverage-baseline.json",
    "test:coverage:baseline": "npm run test:coverage && node scripts/check-coverage-baseline.mjs coverage/coverage-summary.json coverage-baseline.json --write",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test tests/e2e/auth-shelf.spec.ts tests/e2e/shelf-virtual-grid.spec.ts tests/e2e/reader-happy-path.spec.ts tests/e2e/shelf-to-reader.spec.ts tests/e2e/shelf-search.spec.ts tests/e2e/shelf-batch.spec.ts tests/e2e/a11y.spec.ts tests/e2e/performance-budget.spec.ts",
    "test:e2e:search": "playwright test tests/e2e/shelf-search.spec.ts",
    "test:e2e:batch": "playwright test tests/e2e/shelf-batch.spec.ts",
    "test:e2e:virtual": "playwright test tests/e2e/shelf-virtual-grid.spec.ts",
    "test:e2e:reader": "playwright test tests/e2e/reader-happy-path.spec.ts tests/e2e/shelf-to-reader.spec.ts",
    "test:e2e:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "test:e2e:perf": "playwright test tests/e2e/performance-budget.spec.ts",
    "test:js-budget": "node scripts/check-js-budget.mjs",
    "test:js-budget:baseline": "node scripts/check-js-budget.mjs --write",
    "test:visual": "playwright test tests/e2e/visual-regression.spec.ts",
    "test:visual:update": "playwright test tests/e2e/visual-regression.spec.ts --update-snapshots",
    "test:visual:update:linux": "bash scripts/update-visual-linux.sh",
    "test:visual:ui": "playwright test tests/e2e/visual-regression.spec.ts --ui"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@fontsource/crimson-text": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.2.8",
    "@fontsource/playfair-display": "^5.3.0",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@tanstack/react-virtual": "^3.14.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "next": "^16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9",
    "eslint-config-next": "^16.2.11",
    "jsdom": "^29.1.0",
    "sharp": "0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.22"
    },
    "sharp": "0.35.3"
  }
}
